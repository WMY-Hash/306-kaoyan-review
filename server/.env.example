# 306 考研复习 — AI 辅导员后端 环境变量模板
# 复制此文件为 .env 并填入你的 key（.env 不进 git）
# cp .env.example .env

# LLM 提供商：deepseek | gemini
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Embedding 提供商：local | gemini
# local = 本地 sentence-transformers 模型，零费用零网络
# gemini = text-embedding-004 API（需填 GEMINI_API_KEY）
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# Gemini 备用（切换 LLM_PROVIDER=gemini 或 EMBED_PROVIDER=gemini 时需填）
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=text-embedding-004

# 服务端口
SERVER_PORT=8765

# RAG：检索多少条考点作为上下文
RETRIEVAL_TOP_K=5
